# ============================
# Storyloom environment config
# ============================
# Copy this file to .env and fill in your API keys.

# --- LLM Provider API Keys ---
# LiteLLM reads these standard env vars automatically.
# Set only the ones you need based on your skill configurations.

# Anthropic / Claude (used by: editor, continuity, quality)
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (used by: planner, writer)
DEEPSEEK_API_KEY=sk-...

# OpenAI / OpenAI-compatible
# OPENAI_API_KEY=sk-...

# --- Storyloom settings (optional) ---
# STORYLOOM_DATABASE_URL=sqlite:///./storyloom.db
# STORYLOOM_LOG_LEVEL=INFO
